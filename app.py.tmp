# ── 仿真函数 ──────────────────────────────────────
@st.cache_data
def run_simulation(experiment, T0, beta2, beta3, length, gamma, C, m, use_nonlinear, n_points, N_order):
    """运行 SSFM 模拟并返回结果。"""
    Tmax = 5 * T0 + 10
    NT = n_points
    dz = 0.01
    t, dt = time_grid(NT, Tmax)
    w, _ = freq_grid(NT, dt)
    if experiment == "超高斯脉冲展宽":
        A0 = super_gaussian(t, T0, m)
    else:
        A0 = gaussian_pulse(t, T0, C)
    if use_nonlinear:
        P0 = N_order**2 * abs(beta2) / (gamma * T0**2) if gamma > 0 else 1.0
        A0 = A0 * np.sqrt(P0)
        result = ssfm_propagate(A0, t, w, beta2, gamma, length, dz, beta3)
    else:
        result = ssfm_propagate_dispersion_only(A0, t, w, beta2, length, dz, beta3)
    result["t"] = t
    result["w"] = w
    result["A0"] = A0
    return result

data = run_simulation(experiment, T0, beta2, beta3, length, gamma, C, m, use_nonlinear, n_points, N_order)

# ── L1 脉冲显示 ──────────────────────────────────────
if experiment not in L2_EXPS:
    # ── 显示 ──────────────────────────────────────────────
    col1, col2, col3, col4 = st.columns(4)
    with col1:
    init_peak = np.abs(data["A0"]).max() ** 2
    st.metric("初始峰值功率", f"{init_peak:.2f} W")
    with col2:
    final_peak = data["pulse"][-1].max()
    ratio = final_peak / data["pulse"][0].max() if data["pulse"][0].max() > 0 else 0
    st.metric("峰值变化", f"{ratio:.2f}x")
    with col3:
    z_total = data["z"][-1]
    st.metric("传播距离", f"{z_total:.1f} km")
    with col4:
    nz = len(data["z"])
    st.metric("采样帧数", str(nz))
    t = data["t"]; w = data["w"]; z = data["z"]
    pulse = data["pulse"]; spectrum = data["spectrum"]
    f = fftshift(w) / (2 * np.pi)

    # ── 图 ───────────────────────────────────────────────
    st.subheader("诊断图")
    fig, axes = plt.subplots(2, 2, figsize=(14, 8))
    st.info("四子图说明 │ 上左=时域波形(蓝输入/红输出) │ 上右=频谱(蓝输入/红输出) │ 下排=脉冲/频谱演化彩图")
    ax1 = axes[0, 0]
    ax1.plot(t, pulse[0] / pulse[0].max(), "b-", lw=1.5, label="z = 0")
    ax1.plot(t, pulse[-1] / pulse[-1].max(), "r--", lw=1.5, label=f"z = {z[-1]:.1f} km")
    ax1.set_xlabel("Time (ps)"); ax1.set_ylabel("Intensity")
    ax1.set_title("Temporal Profile"); ax1.legend(); ax1.grid(alpha=0.3)
    ax2 = axes[0, 1]
    ax2.plot(f, spectrum[0] / spectrum[0].max(), "b-", lw=1.5, label="z = 0")
    ax2.plot(f, spectrum[-1] / spectrum[-1].max(), "r--", lw=1.5, label=f"z = {z[-1]:.1f} km")
    ax2.set_xlabel("Frequency (THz)"); ax2.set_ylabel("Spectrum")
    ax2.set_title("Spectrum"); ax2.legend(); ax2.grid(alpha=0.3)
    ax3 = axes[1, 0]
    extent = [t[0], t[-1], z[0], z[-1]]
    im = ax3.imshow(pulse, aspect="auto", origin="lower", extent=extent, cmap="inferno")
    ax3.set_xlabel("Time (ps)"); ax3.set_ylabel("Distance (km)")
    ax3.set_title("Pulse Evolution")
    plt.colorbar(im, ax=ax3, label="Intensity")
    ax4 = axes[1, 1]
    extent_f = [f[0], f[-1], z[0], z[-1]]
    im2 = ax4.imshow(spectrum, aspect="auto", origin="lower", extent=extent_f, cmap="inferno")
    ax4.set_xlabel("Frequency (THz)"); ax4.set_ylabel("Distance (km)")
    ax4.set_title("Spectrum Evolution")
    plt.colorbar(im2, ax=ax4, label="Intensity")
    plt.tight_layout()
    st.pyplot(fig)
else:
    t = np.linspace(-10, 10, 256)
    z = np.array([0, 1])
    pulse = np.zeros((2, 256))
    fig = None

# ── L2 可视化 ──────────────────────────────────────
if experiment in ("空间光束衍射","HG/LG 模式","大气湍流","偏振演化","XPM (交叉相位调制)"):
    st.subheader("实验结果")
    x = np.linspace(-3e-3, 3e-3, 256)
    X, Y = np.meshgrid(x, x)
    if experiment == "空间光束衍射":
        E0 = gaussian_beam(X, Y, w0)
        res = beam_propagate(E0, X, Y, wvl, 2.0, 30)
        fig, axes = plt.subplots(1, 4, figsize=(16, 4))
        for idx in range(4):
            zi = idx * 7
            I = np.abs(res["fields"][zi])**2
            axes[idx].imshow(I, extent=[x[0]*1e3, x[-1]*1e3, x[0]*1e3, x[-1]*1e3], cmap="inferno")
            axes[idx].set_title(f"z={res[chr(122)][zi]*1e3:.0f}mm")
            axes[idx].axis("off")
        st.pyplot(fig)
        st.markdown("强泵普通过克尔效应调制弱探针的相位，导致频谱不对称展宽。XPM系数是SPM的两倍。参见L1脉冲实验中的频谱分析。")
    elif experiment == "HG/LG 模式":
        fig, axes = plt.subplots(2, 3, figsize=(12, 8))
        modes=[("Gaussian",gaussian_beam(X,Y,w0)),("HG10",hermite_gaussian_beam(X,Y,w0,1,0)),("HG11",hermite_gaussian_beam(X,Y,w0,1,1)),("LG01",laguerre_gaussian_beam(X,Y,w0,0,1)),("LG02",laguerre_gaussian_beam(X,Y,w0,0,2)),("LG11",laguerre_gaussian_beam(X,Y,w0,1,1))]
        for i,(nm,E) in enumerate(modes):
            r,c=divmod(i,3)
            axes[r,c].imshow(np.abs(E)**2,extent=[x[0]*1e3, x[-1]*1e3, x[0]*1e3, x[-1]*1e3],cmap="inferno")
            axes[r,c].set_title(nm); axes[r,c].axis("off")
        st.pyplot(fig)
        st.markdown("HG和LG模式是光场的完备正交基。HGmn有m×n个节线，LGpl含涡旋相位。上图展示各模式的强度分布。")
    elif experiment == "大气湍流":
        dx = x[1]-x[0]
        phase = kolmogorov_phase_screen(256, dx, r0)
        E0 = gaussian_beam(X, Y, w0)
        E = apply_phase(E0, phase)
        fig, axes = plt.subplots(1, 2, figsize=(12, 5))
        axes[0].imshow(phase, cmap="RdBu", extent=[x[0]*1e3, x[-1]*1e3, x[0]*1e3, x[-1]*1e3])
        axes[0].set_title("Kolmogorov Phase Screen")
        axes[1].imshow(np.abs(E)**2, extent=[x[0]*1e3, x[-1]*1e3, x[0]*1e3, x[-1]*1e3], cmap="inferno")
        axes[1].set_title("Beam After Turbulence")
        st.pyplot(fig)
        st.markdown("HG和LG模式是光场的完备正交基。HGmn有m×n个节线，LGpl含涡旋相位。上图展示各模式的强度分布。")
    elif experiment == "偏振演化":
        from src.nonlinear.polarization import jones_vector, stokes_parameters
        J0 = jones_vector(0, 0)
        J1 = jones_vector(0, np.pi/4)
        S0 = stokes_parameters(J0); S1 = stokes_parameters(J1)
        fig, ax = plt.subplots(figsize=(8, 4))
        x_pos = [0, 1, 2]
        ax.bar([p-0.2 for p in x_pos], [S0[1]/S0[0],S0[2]/S0[0],S0[3]/S0[0]], width=0.35, label="H-Linear")
        ax.bar([p+0.2 for p in x_pos], [S1[1]/S1[0],S1[2]/S1[0],S1[3]/S1[0]], width=0.35, label="R-Circular")
        ax.set_xticks(x_pos); ax.set_xticklabels(["S1","S2","S3"])
        ax.set_ylim(-1.1, 1.1); ax.axhline(0, color="gray")
        ax.legend(); ax.set_title("Stokes Parameters")
        st.pyplot(fig)
        st.markdown("Stokes参数S1S2S3描述偏振态。H线偏→(1,0,0)；R圆偏→(0,0,1)。双折射使偏振态演化。")
    elif experiment == "XPM (交叉相位调制)":
        st.markdown("参见 L1 脉冲传播实验中的频谱分析。")

