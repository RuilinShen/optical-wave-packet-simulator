    if experiment == "高阶孤子 (N>1)":
        N_order = st.sidebar.slider("孤子阶数 N", 2, 4, 2, 1)
    P0_calc = N_order**2 * abs(beta2) / (gamma * T0**2)
    st.sidebar.markdown(f"  N={N_order} 所需峰值功率: **{P0_calc:.1f} W**")
    use_nonlinear = True

